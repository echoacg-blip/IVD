      "name": "Europe PMC · 体外诊断",
      "kind": "json_list",
      "config": {
        "url": "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=TITLE_ABS%3A(%22in%20vitro%20diagnostics%22%20OR%20%22point-of-care%20testing%22%20OR%20%22molecular%20diagnostics%22)%20AND%20HAS_DOI%3AY%20SORT_DATE%3Ay&format=json&resultType=core&pageSize=20",

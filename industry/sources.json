        "itemsPath": "resultList.result",
        "titlePaths": [
          "title"
        ],
        "urlTemplate": "https://doi.org/{doi}",
        "publishedAtPath": "firstPublicationDate",
        "externalIdPath": "doi",
        "summaryPaths": [
